# Required only for email sign-in and private persistent watchlists.
# These two values are public; never put a service-role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side provider credentials. RSS and Yahoo are used without keys.
FINNHUB_API_KEY=
NEWS_API_KEY=
GNEWS_API_KEY=
